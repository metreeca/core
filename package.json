{
  "name": "@metreeca/core",
  "version": "0.13.0",
  "description": "Essential TypeScript abstractions.",
  "keywords": [
    "typescript",
    "utilities"
  ],
  "homepage": "https://metreeca.github.io/core/",
  "bugs": {
    "url": "https://github.com/metreeca/core/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/core.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./values": {
      "@metreeca/source": "./src/types/values.ts",
      "default": "./dist/types/values.js"
    },
    "./numbers": {
      "@metreeca/source": "./src/types/numbers.ts",
      "default": "./dist/types/numbers.js"
    },
    "./strings": {
      "@metreeca/source": "./src/types/strings.ts",
      "default": "./dist/types/strings.js"
    },
    "./arrays": {
      "@metreeca/source": "./src/types/arrays.ts",
      "default": "./dist/types/arrays.js"
    },
    "./async": {
      "@metreeca/source": "./src/services/async/index.ts",
      "default": "./dist/services/async/index.js"
    },
    "./scope": {
      "@metreeca/source": "./src/services/scope.ts",
      "default": "./dist/services/scope.js"
    },
    "./bucket": {
      "@metreeca/source": "./src/services/bucket.ts",
      "default": "./dist/services/bucket.js"
    },
    "./order": {
      "@metreeca/source": "./src/patterns/order.ts",
      "default": "./dist/patterns/order.js"
    },
    "./trace": {
      "@metreeca/source": "./src/patterns/trace.ts",
      "default": "./dist/patterns/trace.js"
    },
    "./relay": {
      "@metreeca/source": "./src/patterns/relay.ts",
      "default": "./dist/patterns/relay.js"
    },
    "./state": {
      "@metreeca/source": "./src/patterns/state.ts",
      "default": "./dist/patterns/state.js"
    },
    "./resource": {
      "@metreeca/source": "./src/standards/resource.ts",
      "default": "./dist/standards/resource.js"
    },
    "./language": {
      "@metreeca/source": "./src/standards/language.ts",
      "default": "./dist/standards/language.js"
    },
    "./datatype": {
      "@metreeca/source": "./src/standards/datatype.ts",
      "default": "./dist/standards/datatype.js"
    },
    "./base64": {
      "@metreeca/source": "./src/standards/base64.ts",
      "default": "./dist/standards/base64.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ln",
    "build": "ush rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.5.0",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
