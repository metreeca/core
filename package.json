{
  "name": "@metreeca/core",
  "version": "0.9.19",
  "description": "Essential TypeScript abstractions.",
  "keywords": [
    "typescript",
    "utilities"
  ],
  "homepage": "https://metreeca.github.io/core/",
  "bugs": {
    "url": "https://github.com/metreeca/core/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/core.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./strings": "./dist/values/strings.js",
    "./numbers": "./dist/values/numbers.js",
    "./arrays": "./dist/values/arrays.js",
    "./structures": "./dist/values/structures.js",
    "./async": "./dist/runtime/async/index.js",
    "./fetch": "./dist/runtime/fetch/index.js",
    "./scope": "./dist/runtime/scope.js",
    "./order": "./dist/functional/order.js",
    "./trace": "./dist/functional/trace.js",
    "./relay": "./dist/functional/relay.js",
    "./state": "./dist/functional/state.js",
    "./http": "./dist/standard/http.js",
    "./resource": "./dist/standard/resource.js",
    "./language": "./dist/standard/language.js",
    "./datatype": "./dist/standard/datatype.js",
    "./base64": "./dist/standard/base64.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist docs node_modules",
    "setup": "npm install",
    "build": "rm -rf dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx five-server docs --open)"
  },
  "devDependencies": {
    "five-server": "^0.4.5",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
