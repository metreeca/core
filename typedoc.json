{
  "tsconfig": "./tsconfig.build.json",
  "includeVersion": true,
  "excludeExternals": true,
  "sort": [
    "source-order"
  ],
  "sortEntryPoints": false,
  "categorizeByGroup": true,
  "groupOrder": [
    "Variables",
    "Interfaces",
    "Type Aliases",
    "*"
  ],
  "useFirstParagraphOfCommentAsSummary": true,
  "favicon": "https://metreeca.com/assets/icon.ico",
  "sourceLinkExternal": true,
  "markdownLinkExternal": true,
  "externalSymbolLinkMappings": {
    "global": {
      "DOMException": "https://developer.mozilla.org/docs/Web/API/DOMException",
      "Error": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/Error",
      "RangeError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/RangeError",
      "ReferenceError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/ReferenceError",
      "TypeError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/TypeError",
      "URIError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/URIError"
    },
    "typescript": {
      "DOMException": "https://developer.mozilla.org/docs/Web/API/DOMException",
      "Error": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/Error",
      "RangeError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/RangeError",
      "ReferenceError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/ReferenceError",
      "TypeError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/TypeError",
      "URIError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/URIError"
    }
  },
  "navigationLinks": {
    "GitHub": "https://github.com/metreeca/core"
  },
  "githubPages": false,
  "hideGenerator": true,
  "customFooterHtml": "<a href='https://www.metreeca.com/' style='display: flex; align-items: center; gap: 0.25em'><img src='https://metreeca.com/assets/icon.svg' alt='Metreeca' style='width: 1.25em; height: 1.25em;'/><span>Copyright © 2025-2026 Metreeca</span></a>",
  "headings": {
    "readme": false
  }
}
